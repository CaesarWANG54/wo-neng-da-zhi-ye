{
  "name": "wo-neng-da-zhi-ye",
  "private": true,
  "version": "0.1.0",
  "author": "《我能打职业》项目作者",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "test:runtime": "node scripts/run-playwright.mjs",
    "test:native": "node scripts/run-playwright.mjs --config=playwright.native.config.ts",
    "test:core": "vitest run src/game",
    "check:content": "node scripts/check-game-content.mjs",
    "verify": "npm run test && npm run build",
    "test": "npm run test:core && npm run test:runtime",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:release": "node --test tests/release-readiness.test.mjs",
    "check:notices": "node scripts/check-third-party-notices.mjs",
    "update:notices": "node scripts/check-third-party-notices.mjs --write",
    "check:release": "node scripts/release-readiness.mjs && npm run check:notices && npm run test:release && npm run check:runtime && npm run test:core && npm run test:runtime && npm run test:native && npm run build && npm run test:sites",
    "check:release:public": "node scripts/release-readiness.mjs --strict-public && npm run check:release && node scripts/check-game-content.mjs --strict-public",
    "predev": "npm run check:runtime",
    "dev": "vite --host 127.0.0.1",
    "predev:iphone": "npm run check:runtime",
    "dev:iphone": "vite --host 0.0.0.0 --port 4173 --strictPort",
    "prebuild": "npm run check:runtime",
    "build": "tsc && vite build && node scripts/prepare-sites-build.mjs",
    "postbuild": "npm run check:content"
  },
  "dependencies": {
    "@fontsource/roboto": "5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@use-gesture/react": "10.3.1",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.3",
    "vitest": "^4.1.11"
  }
}
